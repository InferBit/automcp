# AutoMCP self-hosted stack — environment configuration

# Domain & TLS (used by nginx)
DOMAIN=automcp.localhost
TLS_CERT_PATH=./nginx/certs/fullchain.pem
TLS_KEY_PATH=./nginx/certs/privkey.pem

# MongoDB
MONGO_URL=mongodb://mongo:27017/automcp
MONGO_USER=automcp
MONGO_PASSWORD=changeme
MONGO_DATABASE=automcp

# Typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=changeme

# API service
SPEC_STORAGE=mongo
ADMIN_NOTIFICATION_WEBHOOK=

# UI service — what URL the browser hits to reach the API
# In prod with nginx in front, this should be your public domain + /api
UI_PUBLIC_API_URL=http://localhost/api
